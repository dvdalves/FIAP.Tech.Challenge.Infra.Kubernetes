azure_region             = "North Central US"
resource_group_name      = "fiap-tech-challenge-rg"
environment              = "production"
cluster_name             = "oficina-aks-cluster"
cluster_version          = "1.30.3"
vnet_address_space       = "10.0.0.0/16"
k8s_node_vm_size         = "Standard_B2as_v2"
node_subnet_prefix       = "10.0.1.0/24"
service_subnet_prefix    = ["10.0.2.0/24"]
node_desired_size        = 1
node_min_size            = 1
node_max_size            = 1
api_gateway_name         = "oficina-main-apim"
publisher_email          = "architecture@example.com"
enable_datadog           = false
datadog_api_key          = ""
datadog_site             = "datadoghq.com"
enable_metrics_server    = true
enable_monitor_alerts = true
